const INSIGHTS = {
  hot: "이번 회차 1·2위를 크랩이 스포츠 행정 소재로 나란히 가져갔습니다. 축구협회 청문회 편(74만회)을 낸 뒤 하루 지나 '양궁협회와 비교되는 진짜 이유'(28만회)를 붙여, 하나의 사건을 비교 프레임으로 한 번 더 우려먹는 2회차 구성이 그대로 통했습니다. 원주MBC도 지역 체육회·기관 이슈에서 '잘하는 곳 vs 못하는 곳' 대조 구도를 쓰면 단발 리포트를 연작으로 늘릴 수 있습니다. 두 번째 축은 중국 리스크로, 비디오머그가 중국 반도체의 삼성·하이닉스 추격(9.1만회)과 미국의 중국산 로봇 수입금지(4.7만회)를 사흘 안에 냈고 14F 경제 모음(5.6만회)에도 창신메모리가 들어가 세 편이 같은 화두를 공유했습니다. 세 번째로 유럽 소재가 4편(포르투갈-스페인 국경, 포르투갈 섬, 프랑스 맥주, 올리브유 사기극) 올라온 점이 눈에 띄는데, 특히 지식한잔은 포르투갈 소재 2편을 이틀 연속 붙여 크랩과 똑같은 연작 전략을 지도·역사 교양에서 반복했습니다.",
  title: "여전히 물음표가 주력입니다. 20편 중 7편이 질문형이었는데, 이번엔 '이게 최선이었습니까?', '왜 제가 해야 돼요?', '진짜 전쟁 나요?', 'KTX 요금 내린다고?'처럼 시청자가 실제로 내뱉을 법한 반말·구어 어미를 그대로 제목에 올린 사례가 많았습니다. 두 번째는 문장을 통째로 인용부호 없이 따오는 방식입니다. 크랩 5위 '움직이시면 안 돼요 무서우면 말씀해주세요'는 설명을 아예 지우고 현장 발언만 남겨 13만회를 기록했는데, 이건 원주MBC 클립 제목 규칙(발언 인용형 후킹)과 정확히 같은 문법입니다. 세 번째는 작은따옴표 도장 찍기로 '최대 고객', '구글맵에도 등장', '스파이더맨 4'처럼 핵심어만 떼어 훅으로 세웁니다. 숫자 훅(한 달 새 5만 명, 7가지, 코카인 수입의 세 배, 9월 통합)과 말줄임표로 결론을 미루는 구조가 5편, 코너명 병기(ㅣ돈슐랭, [모아봤스], /머그인사이트, /똑소리E, #지식채널e)는 8편으로 이제 사실상 표준 표기가 됐습니다. 지식한잔의 'ㄷㄷ'처럼 커뮤니티 말투를 그대로 붙이는 것도 7만회대 성적을 냈습니다.",
  format: "실측하면 5분 이하 8편, 10분 미만까지 12편으로 짧은 쪽이 과반이지만 1위(10:14)와 4위(14:33)가 10분을 넘겨 길이가 성적을 결정하진 않았습니다. 채널 규격은 지난 회차보다 더 또렷합니다. 크랩은 5편 중 4편이 4분 22초~6분 32초에 모여 '5분 표준'을 굳혔고 예외인 청문회 편만 10분대인데 그게 1위였습니다 — 즉 평소 규격을 지키다가 큰 건에만 길이를 푸는 운용입니다. 비디오머그는 4편 중 3편이 11분 11초~14분 47초로 해설 롱폼을 유지했습니다. 14F는 2분 29초·2분 34초 숏폼과 10분 22초·19분 48초·38분 07초 롱폼으로 완전히 갈렸는데, 이번엔 숏폼 2편이 모두 1만회 안팎에 그쳐 양극화 전략이 항상 먹히지는 않는다는 신호로 보입니다. 사물궁이(3:48), 지식채널e(4:26)처럼 말랑한 톤의 채널은 이번에도 4분 전후로, 원주MBC 숏폼의 주력 구간과 겹칩니다. 4~6분대를 고정 규격으로 삼고 큰 사안에만 10분대를 쓰는 크랩식 운용이 이번 데이터에서 가장 안정적이었습니다."
};

function thumbUrl(id) {
  return `https://i.ytimg.com/vi/${id}/mqdefault.jpg`;
}

function renderGrid(containerId, items) {
  const el = document.getElementById(containerId);
  el.innerHTML = items.map(v => `
    <a class="card" href="https://www.youtube.com/watch?v=${v.id}" target="_blank" rel="noopener">
      <div class="thumb-wrap">
        <span class="rank">${v.rank}</span>
        <img src="${thumbUrl(v.id)}" alt="${v.title.replace(/"/g, '&quot;')}">
      </div>
      <div class="card-body">
        <div class="title">${v.title}</div>
        <div class="meta">
          <span class="channel">${v.channel}</span>
          <span>${v.views} · ${v.uploaded}</span>
        </div>
      </div>
    </a>
  `).join('');
}

renderGrid('domesticGrid', DOMESTIC);
renderGrid('intlGrid', INTL);
document.getElementById('insightHot').textContent = INSIGHTS.hot;
document.getElementById('insightTitle').textContent = INSIGHTS.title;
document.getElementById('insightFormat').textContent = INSIGHTS.format;
</script>
</body>
</html>
