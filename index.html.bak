const INTL = [
  {rank:1, title:"How a Super El Niño affects the global climate", channel:"Vox", id:"W4k_34hIdnQ", views:"52만회", uploaded:"4일 전", duration:"6:37"},
  {rank:2, title:"멕시코가 간절히 실존하길 바라는 사라진 섬", channel:"Half as Interesting", id:"eFmMyMLuWIY", views:"18만회", uploaded:"5일 전", duration:"7:55"},
  {rank:3, title:"Red gold: The world's most expensive spice - Carolyn Beans", channel:"TED-Ed", id:"krNP8RlDsbw", views:"14만회", uploaded:"5일 전", duration:"6:41"},
  {rank:4, title:"How Goodwill Actually Works", channel:"Business Insider", id:"UKypOcYjjkI", views:"6.6만회", uploaded:"2일 전", duration:"16:49"},
  {rank:5, title:"예일대 병원 청소부에서 의사가 되기까지", channel:"CNBC Make It", id:"YAUrq_SNYrI", views:"6.3만회", uploaded:"2일 전", duration:"8:03"},
  {rank:6, title:"9 Ways Everyday Life Is Becoming More Expensive", channel:"Business Insider", id:"wjkeJ6sEYfc", views:"4.6만회", uploaded:"1일 전", duration:"2:59:13"},
  {rank:7, title:"가족 기업이 파산 위기에서 연 매출 1조 6천억 원 기업으로 성장한 비결", channel:"CNBC Make It", id:"P1MdTY21wVo", views:"2.3만회", uploaded:"4일 전", duration:"8:49"},
  {rank:8, title:"구글은 어떻게 인터넷을 망가뜨렸나 | 더 그레이 에어리어", channel:"Vox", id:"PuG88DamVZ0", views:"1.8만회", uploaded:"2일 전", duration:"39:19"},
  {rank:9, title:"'자아'라는 환상 | The Gray Area", channel:"Vox", id:"b34Dfxu9j0U", views:"1.7만회", uploaded:"6일 전", duration:"42:30"},
  {rank:10, title:"전통적인 아메리칸 드림은 끝났을까?", channel:"CNBC Make It", id:"0Ik8SzCPMOY", views:"1만회", uploaded:"7일 전", duration:"15:21"}
